# InboxIQ — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# Database
INBOXIQ_DATABASE_URL=mysql://user:pass@gateway01.us-east-1.tidbcloud.com:4000/inboxiq?ssl=true

# Auth
JWT_SECRET=generate-a-strong-random-secret-here

# Token encryption (AES-256 — must be 64 hex chars = 32 bytes)
TOKEN_ENCRYPTION_KEY=generate-64-char-hex-string-here

# OpenAI
OPENAI_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs
STRIPE_PRICE_PERSONAL=price_...   # $4.99/month
STRIPE_PRICE_TEAM=price_...       # $19.99/month
STRIPE_PRICE_TEAM_PLUS=price_...  # $49.99/month

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://inboxiq.reviveiqi.com/api/oauth/gmail/callback

# Microsoft OAuth (Outlook)
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...
MICROSOFT_REDIRECT_URI=https://inboxiq.reviveiqi.com/api/oauth/outlook/callback

# Resend (email digests)
RESEND_API_KEY=re_...

# App
PORT=3001
NODE_ENV=production
APP_URL=https://inboxiq.reviveiqi.com
